# MongoDB connection string (e.g. MongoDB Atlas)
MONGO=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/booking?retryWrites=true&w=majority
# Long random secret used to sign login tokens
JWT=change-me-to-a-long-random-string
# Optional: booking confirmation emails. Set ONE of these keys:
#   Resend (https://resend.com) - without a verified domain it only delivers to your own Resend email
RESEND_API_KEY=
#   Brevo (https://www.brevo.com) - verify a single sender address; delivers to anyone
BREVO_API_KEY=
# Sender address (Resend default for testing: onboarding@resend.dev)
MAIL_FROM=
MAIL_FROM_NAME=Staybook
# Optional: public site URL used in email links (Render sets RENDER_EXTERNAL_URL automatically)
APP_URL=http://localhost:3000
# Optional (Render sets PORT automatically)
PORT=8800
